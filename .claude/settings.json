{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(git push origin *)",
      "Bash(git push -u origin *)",
      "Bash(gh pr create *)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(aws *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Read(*.pem)",
      "Bash(git push*--force*)",
      "Bash(git push* -f*)"
    ]
  }
}
